{
  "name": "the-impersonator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/seed.ts",
    "build:local": "next build",
    "seed:verify": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/seed-verify.ts",
    "fetch-text": "tsx --tsconfig tsconfig.json scripts/fetch-text.ts",
    "research-api": "tsx --tsconfig tsconfig.json scripts/research-api.ts",
    "persona-meta": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/persona-meta.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "linkedom": "^0.18.15",
    "next": "16.4.6",
    "openai": "^7.63.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^2.2.2",
    "workflow": "^5.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
