# Postgres connection string (Neon on Vercel; docker-compose locally)
DATABASE_URL=postgres://impersonator:impersonator@localhost:5433/impersonator

# Model provider: "azure" for Azure OpenAI, anything else for the public OpenAI API (OPENAI_API_KEY)
OPENAI_PROVIDER=azure
AZURE_OPENAI_API_KEY=
# Azure OpenAI v1 endpoint, ending in /openai/v1
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# Model, or deployment name on Azure
OPENAI_MODEL=gpt-5.5

# Google sign-in (OAuth client: Web application). Redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ char string used to sign session cookies (required in production)
AUTH_SECRET=
# Comma-separated Google Workspace domains allowed to sign in
ALLOWED_EMAIL_DOMAINS=genezio.com,genez.io
# Public URL of the app (optional; defaults to the request origin)
APP_URL=
# Minimum number of distinct real people that must support a trait/belief
MIN_SUBJECTS_PER_TRAIT=2
